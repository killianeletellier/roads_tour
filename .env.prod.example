# Copy to .env.prod and fill in values. Never commit .env.prod.
#
# Usage:
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# --- PostgreSQL ---
POSTGRES_USER=roadstour
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=roadstour

# Prisma / app (host must be "postgres" inside Docker network)
DATABASE_URL=postgresql://roadstour:change-me-strong-password@postgres:5432/roadstour

# --- Application secrets ---
# Global admin password for /admin/login
ADMIN_PASSWORD=change-me-admin-password

# JWT signing secret (random string, 32+ chars)
JWT_SECRET=change-me-jwt-secret-min-32-chars

# Optional: allow template secrets at startup (logs loud warnings; not for real production)
# ALLOW_INSECURE_SECRETS=1

# --- Routing (internal Docker network only) ---
OSRM_URL=http://osrm:5000

# --- HTTPS / Let's Encrypt ---
# Public domain pointing to this server (A/AAAA records)
DOMAIN=roadstour.example.com

# Email for Let's Encrypt expiry notices (required for init-letsencrypt.sh)
CERTBOT_EMAIL=admin@example.com

# Set to 1 to use Let's Encrypt staging (avoid rate limits while testing)
CERTBOT_STAGING=0
