{
  "name": "@roads-tour/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file=../../.env ../../node_modules/.bin/prisma migrate deploy",
    "db:migrate:dev": "node --env-file=../../.env ../../node_modules/.bin/prisma migrate dev",
    "db:push": "node --env-file=../../.env ../../node_modules/.bin/prisma db push"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@prisma/client": "^6.3.1",
    "@roads-tour/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.12.0",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
